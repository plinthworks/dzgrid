---
/**
 * Every feature in one table, from the sources (src/generated/options.json): its function — a link when its page is
 * written —, the entry it comes from, and its page's description.
 *
 *   <FeatureList />
 */
import { getCollection } from 'astro:content';
import data from '../generated/options.json';

const fr = Astro.currentLocale === 'fr';
const kebab = (name: string) => name.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);
const docs = await getCollection('docs');
const page = (name: string) => docs.find((d) => d.id === `${fr ? 'fr/' : ''}features/${kebab(name)}`);
const rows = data.features.map((f) => ({ name: f.name, entry: f.entry, page: page(f.name) }));
const words = fr ? { name: 'Fonction', entry: 'Import', what: 'Rôle' } : { name: 'Function', entry: 'Import', what: 'What it does' };
---

<div class="dzg-option-list">
  <table>
    <thead><tr><th scope="col">{words.name}</th><th scope="col">{words.entry}</th><th scope="col">{words.what}</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.page ? <a href={`./${kebab(r.name)}/`}><code>{r.name}</code></a> : <code>{r.name}</code>}</th>
          <td><code>{r.entry}</code></td>
          <td>{r.page?.data.description ?? ''}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
