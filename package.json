{
  "name": "dzgrid-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=1",
    "test:perm": "PERMS=1000 vitest run --maxWorkers=1 packages/dom/test/audit-permutations.test.ts packages/dom/test/export-permutations.test.ts packages/dom/test/edit-saves-walk.test.ts packages/dom/test/edit-permutations.test.ts packages/dom/test/edit-undo-walk.test.ts",
    "test:watch": "vitest",
    "test:tz": "TZ=Pacific/Auckland vitest run --maxWorkers=2 && TZ=America/Los_Angeles vitest run --maxWorkers=2",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/dom/tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit && ngc -p packages/angular/tsconfig.spec.json --noEmit",
    "build": "node scripts/build.mjs",
    "build:angular": "node scripts/build.mjs --angular",
    "pack:local": "npm run build && rm -rf packed.tmp && mkdir packed.tmp && for p in core dom angular; do (cd packages/$p/dist && npm pack --pack-destination ../../../packed.tmp >/dev/null) || exit 1; done && (cd packages/theme && npm pack --pack-destination ../../packed.tmp >/dev/null) && rm -rf packed && mv packed.tmp packed && ls packed",
    "spike": "node scripts/spikes.mjs",
    "start": "vite",
    "bench": "node scripts/bench.mjs",
    "check:size": "node scripts/size.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "build:theme": "node scripts/build-theme.mjs",
    "test:browser": "node scripts/browser.mjs",
    "test:audit": "node scripts/audit-browser.mjs",
    "bench:browser": "node scripts/perf-browser.mjs",
    "example:build": "node scripts/example.mjs build",
    "example:csv": "node scripts/example.mjs csv",
    "example:ssr": "node scripts/example.mjs ssr && node scripts/example.mjs ssr --lang ar && node scripts/example.mjs ssr --screen stock && node scripts/example.mjs ssr --screen stock --lang ar",
    "example:bytes": "node scripts/example.mjs bytes",
    "example:browser": "node scripts/example.mjs browser",
    "example:smoke": "node scripts/example.mjs smoke"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.1",
    "@angular/build": "^21.2.27",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.20.4",
    "@tzslot/core": "2.2.0",
    "@tzslot/dom": "2.2.0",
    "axe-core": "^4.14.0",
    "bootstrap": "5.3.8",
    "esbuild": "^0.25.10",
    "gsap": "^3.13.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "^21.2.7",
    "playwright-core": "^1.55.1",
    "rxjs": "~7.8.0",
    "sass": "^1.105.2",
    "tailwindcss": "4.3.3",
    "tailwindcss3": "npm:tailwindcss@3.4.19",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "vite": "^6.3.6",
    "vitest": "^4.0.8",
    "zone.js": "^0.16.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
