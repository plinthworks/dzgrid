{
  "name": "dzgrid-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:tz": "TZ=Pacific/Auckland vitest run && TZ=America/Los_Angeles vitest run",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "build": "node scripts/build.mjs",
    "spike": "node scripts/spikes.mjs",
    "start": "vite",
    "bench": "node scripts/bench.mjs",
    "check:size": "node scripts/size.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.1",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@types/node": "^22.20.4",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.10",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.55.1",
    "rxjs": "~7.8.0",
    "sass": "^1.105.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "vite": "^6.3.6",
    "vitest": "^4.0.8"
  },
  "workspaces": [
    "packages/*"
  ]
}
