{
  "name": "@dzgrid/theme",
  "version": "0.1.0",
  "description": "An optional stylesheet for DzGrid: tzslot's palette, light and dark, more contrast, forced colours. Plain CSS.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/plinthworks/dzgrid.git", "directory": "packages/theme" },
  "homepage": "https://github.com/plinthworks/dzgrid#readme",
  "bugs": { "url": "https://github.com/plinthworks/dzgrid/issues" },
  "main": "./dzgrid.css",
  "exports": {
    ".": "./dzgrid.css",
    "./dzgrid.css": "./dzgrid.css",
    "./contrast.css": "./contrast.css",
    "./contrast-pairs.json": "./contrast-pairs.json",
    "./dzgrid.scss": "./dzgrid.scss",
    "./dzgrid": { "sass": "./dzgrid.scss", "default": "./dzgrid.css" },
    "./tailwind.css": "./tailwind.css"
  },
  "files": ["dzgrid.css", "dzgrid.scss", "contrast.css", "contrast-pairs.json", "tailwind.css"],
  "sideEffects": ["*.css"],
  "sass": "./dzgrid.scss"
}
