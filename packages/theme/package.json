{
  "name": "@dzgrid/theme",
  "version": "0.2.0",
  "description": "An optional stylesheet for DzGrid: tzslot's palette, light and dark, more contrast, forced colours; two showcase themes; bridges to Tailwind CSS 3 and 4 and Bootstrap 5.3. Plain CSS.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/plinthworks/dzgrid.git", "directory": "packages/theme" },
  "homepage": "https://github.com/plinthworks/dzgrid#readme",
  "bugs": { "url": "https://github.com/plinthworks/dzgrid/issues" },
  "main": "./dzgrid.css",
  "exports": {
    ".": "./dzgrid.css",
    "./dzgrid.css": "./dzgrid.css",
    "./contrast.css": "./contrast.css",
    "./contrast-pairs.json": "./contrast-pairs.json",
    "./dzgrid.scss": "./dzgrid.scss",
    "./dzgrid": { "sass": "./dzgrid.scss", "default": "./dzgrid.css" },
    "./tailwind.css": "./tailwind.css",
    "./dzgrid.unlayered.css": "./dzgrid.unlayered.css",
    "./contrast.unlayered.css": "./contrast.unlayered.css",
    "./midnight.css": "./midnight.css",
    "./clinic.css": "./clinic.css",
    "./contrast.scss": "./contrast.scss",
    "./tailwind3.css": "./tailwind3.css",
    "./bootstrap.css": "./bootstrap.css",
    "./edit.css": "./edit.css",
    "./edit.unlayered.css": "./edit.unlayered.css",
    "./edit.scss": "./edit.scss"
  },
  "files": ["dzgrid.css", "dzgrid.unlayered.css", "dzgrid.scss", "contrast.css", "contrast.unlayered.css", "contrast.scss", "contrast-pairs.json", "tailwind.css", "tailwind3.css", "bootstrap.css", "midnight.css", "clinic.css", "edit.css", "edit.unlayered.css", "edit.scss"],
  "sideEffects": ["*.css"],
  "sass": "./dzgrid.scss"
}
