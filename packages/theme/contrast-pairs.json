    "--dzg-flash-color": "var(--tz-accent)",
    "--dzg-flash-bg": "color-mix(in srgb, var(--dzg-flash-color) 18%, var(--tz-bg))",
    "--dzg-flash-selected-bg": "color-mix(in srgb, var(--dzg-flash-color) 18%, var(--dzg-row-selected-bg))",
    "--dzg-flash-hover-bg": "color-mix(in srgb, var(--dzg-flash-color) 18%, var(--dzg-row-hover-bg))",
    "--dzg-saving-color": "var(--tz-warning)",
    "--dzg-refused-color": "var(--tz-danger)",
    "--dzg-saved-color": "var(--tz-success)",
    "--dzg-range-bg": "var(--dzg-row-selected-bg)",
    "--dzg-range-edge": "var(--tz-success)",
    "--dzg-fill-handle": "var(--dzg-range-edge)",
    "--dzg-move-bar": "var(--tz-accent)",
    "--dzg-menu-disabled": "var(--tz-fg-muted)",
    "--dzg-cell-active-bg": "color-mix(in srgb, var(--tz-accent) 10%, var(--tz-bg))",
    "--dzg-row-active-bg": "color-mix(in srgb, var(--tz-fg) 6%, var(--tz-bg))"
  }
}
