{
  "$comment": "Every text or part the theme draws, on every surface it is drawn on. Checked by scripts/check-contrast.mjs for each palette, light and dark: text 4.5:1, parts 3:1.",
  "pairs": [
    { "what": "cell text", "fg": "--tz-fg", "bg": "--tz-bg", "min": 4.5 },
    { "what": "cell text on hover", "fg": "--tz-fg", "bg": "--dzg-row-hover-bg", "min": 4.5 },
    { "what": "cell text, selected row", "fg": "--tz-fg", "bg": "--dzg-row-selected-bg", "min": 4.5 },
    { "what": "header text", "fg": "--tz-fg", "bg": "--dzg-header-bg", "min": 4.5 },
    { "what": "sort mark", "fg": "--tz-fg-muted", "bg": "--dzg-header-bg", "min": 4.5 },
    { "what": "overlay text", "fg": "--tz-fg-muted", "bg": "--tz-bg", "min": 4.5 },
    { "what": "stale rows while the next load", "fg": "--dzg-stale-fg", "bg": "--tz-bg", "min": 4.5 },
    { "what": "stale rows, selected", "fg": "--dzg-stale-fg", "bg": "--dzg-row-selected-bg", "min": 4.5 },
    { "what": "stale rows on hover", "fg": "--dzg-stale-fg", "bg": "--dzg-row-hover-bg", "min": 4.5 },
    { "what": "tooltip text", "fg": "--tz-bg", "bg": "--tz-fg", "min": 4.5 },
    { "what": "retry button text", "fg": "--tz-fg", "bg": "--dzg-header-bg", "min": 4.5 },
    { "what": "retry button border", "fg": "--tz-fg-muted", "bg": "--tz-bg", "min": 3 },
    { "what": "focus ring on the retry button", "fg": "--dzg-focus-ring", "bg": "--tz-bg", "min": 3 },
    { "what": "focus ring on a cell", "fg": "--dzg-focus-ring", "bg": "--tz-bg", "min": 3 },
    { "what": "focus ring on a selected row", "fg": "--dzg-focus-ring", "bg": "--dzg-row-selected-bg", "min": 3 },
    { "what": "focus ring on the header", "fg": "--dzg-focus-ring", "bg": "--dzg-header-bg", "min": 3 },
    { "what": "filter box text", "fg": "--tz-fg", "bg": "--tz-bg", "min": 4.5 },
    { "what": "filter box and Clear border", "fg": "--tz-fg-muted", "bg": "--dzg-header-bg", "min": 3 },
    { "what": "filter summary text", "fg": "--tz-fg-muted", "bg": "--dzg-header-bg", "min": 4.5 },
    { "what": "invalid filter box outline", "fg": "--tz-danger", "bg": "--dzg-header-bg", "min": 3 },
    { "what": "focus ring on a filter box", "fg": "--dzg-focus-ring", "bg": "--dzg-header-bg", "min": 3 },
    { "what": "filter popup text and labels", "fg": "--tz-fg", "bg": "--tz-bg", "min": 4.5 },
    { "what": "filter popup's fields and buttons border", "fg": "--tz-fg-muted", "bg": "--tz-bg", "min": 3 },
    { "what": "filter popup's Clear and Apply text", "fg": "--tz-fg", "bg": "--dzg-header-bg", "min": 4.5 },
    { "what": "focus ring in the filter popup", "fg": "--dzg-focus-ring", "bg": "--tz-bg", "min": 3 },
    { "what": "header filter button", "fg": "--tz-fg-muted", "bg": "--dzg-header-bg", "min": 3 },
    { "what": "header filter button, filtered", "fg": "--tz-accent", "bg": "--dzg-header-bg", "min": 3 },
    { "what": "focus ring on the header filter button", "fg": "--dzg-focus-ring", "bg": "--dzg-header-bg", "min": 3 },
    { "what": "check box border", "fg": "--tz-fg-muted", "bg": "--tz-bg", "min": 3 },
    { "what": "check mark", "fg": "--tz-accent-fg", "bg": "--tz-accent", "min": 3 },
    { "what": "ticked box on a selected row", "fg": "--tz-accent", "bg": "--dzg-row-selected-bg", "min": 3 },
    { "what": "resize grip, hover", "fg": "--tz-accent", "bg": "--dzg-header-bg", "min": 3 },
    { "what": "grid border and cell rule (decorative)", "fg": "--tz-border", "bg": "--tz-bg", "min": 1 },
    { "what": "date panel text (tzslot's, in a filter popup)", "fg": "--tz-fg", "bg": "--tz-bg", "min": 4.5 },
    { "what": "date panel chosen day", "fg": "--tz-accent-fg", "bg": "--tz-accent", "min": 4.5 },
    { "what": "date panel notes and outside days", "fg": "--tz-fg-muted", "bg": "--tz-bg", "min": 4.5 }
  ],
  "derived": {
    "--dzg-header-bg": "var(--tz-bg-raised)",
    "--dzg-row-hover-bg": "color-mix(in srgb, var(--tz-accent) 6%, var(--tz-bg))",
    "--dzg-row-selected-bg": "color-mix(in srgb, var(--tz-accent) 14%, var(--tz-bg))",
    "--dzg-focus-ring": "var(--tz-accent)",
    "--dzg-stale-fg": "var(--tz-fg-muted)"
  }
}
