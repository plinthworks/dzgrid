{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "noEmit": false,
    "inlineSources": true,
    "paths": {
      "@dzgrid/core": ["../core/dist/index.d.ts"],
      "@dzgrid/core/internal": ["../core/dist/internal.d.ts"],
      "@dzgrid/core/spans": ["../core/dist/spans.d.ts"],
      "@dzgrid/core/csv": ["../core/dist/csv.d.ts"],
      "@dzgrid/core/rules": ["../core/dist/rules.d.ts"],
      "@dzgrid/core/tree": ["../core/dist/tree.d.ts"],
      "@dzgrid/core/tree-lazy": ["../core/dist/tree-lazy.d.ts"],
      "@dzgrid/core/detail": ["../core/dist/detail.d.ts"],
      "@dzgrid/core/server": ["../core/dist/server.d.ts"],
      "@dzgrid/dom/internal": ["./src/internal.ts"],
      "@dzgrid/dom": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
