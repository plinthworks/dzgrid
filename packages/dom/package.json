{
  "name": "@dzgrid/dom",
  "version": "0.0.0",
  "description": "DzGrid in the browser: virtualised rows and columns, pinned columns, right to left, keyboard and screen readers. No framework, no dependency.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./popup": {
      "types": "./src/popup.ts",
      "default": "./src/popup.ts"
    },
    "./spans": {
      "types": "./src/spans.ts",
      "default": "./src/spans.ts"
    },
    "./slots": {
      "types": "./src/slots.ts",
      "default": "./src/slots.ts"
    },
    "./filters": {
      "types": "./src/filters.ts",
      "default": "./src/filters.ts"
    },
    "./locales/en": {
      "types": "./src/locales/en.ts",
      "default": "./src/locales/en.ts"
    },
    "./locales/fr": {
      "types": "./src/locales/fr.ts",
      "default": "./src/locales/fr.ts"
    },
    "./locales/ar": {
      "types": "./src/locales/ar.ts",
      "default": "./src/locales/ar.ts"
    },
    "./locales/en-filters": {
      "types": "./src/locales/en-filters.ts",
      "default": "./src/locales/en-filters.ts"
    },
    "./locales/fr-filters": {
      "types": "./src/locales/fr-filters.ts",
      "default": "./src/locales/fr-filters.ts"
    },
    "./locales/ar-filters": {
      "types": "./src/locales/ar-filters.ts",
      "default": "./src/locales/ar-filters.ts"
    }
  },
  "peerDependencies": {
    "@dzgrid/core": "0.0.0"
  }
}
