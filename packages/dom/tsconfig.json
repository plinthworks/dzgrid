{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@dzgrid/core": ["../core/src/index.ts"],
      "@dzgrid/core/internal": ["../core/src/internal.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
