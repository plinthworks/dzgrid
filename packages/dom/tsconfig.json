{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@dzgrid/core": ["../core/src/index.ts"],
      "@dzgrid/core/internal": ["../core/src/internal.ts"],
      "@dzgrid/core/spans": ["../core/src/spans.ts"],
      "@dzgrid/core/csv": ["../core/src/csv.ts"],
      "@dzgrid/core/rules": ["../core/src/rules.ts"],
      "@dzgrid/core/tree": ["../core/src/tree.ts"],
      "@dzgrid/core/tree-lazy": ["../core/src/tree-lazy.ts"],
      "@dzgrid/core/detail": ["../core/src/detail.ts"],
      "@dzgrid/core/edit": ["../core/src/edit.ts"],
      "@dzgrid/core/range": ["../core/src/range.ts"],
      "@dzgrid/core/server": ["../core/src/server.ts"],
      "@dzgrid/dom/internal": ["./src/internal.ts"],
      "@dzgrid/dom": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
