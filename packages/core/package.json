{
  "name": "@dzgrid/core",
  "version": "0.1.0",
  "description": "Data grid model, from scratch: typed row identities, calendar days kept apart from instants, sorting and filtering. No DOM, no framework, no Date, no dependency.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal": {
      "types": "./src/internal.ts",
      "default": "./src/internal.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./spans": {
      "types": "./src/spans.ts",
      "default": "./src/spans.ts"
    },
    "./csv": {
      "types": "./src/csv.ts",
      "default": "./src/csv.ts"
    },
    "./rules": {
      "types": "./src/rules.ts",
      "default": "./src/rules.ts"
    },
    "./tree": {
      "types": "./src/tree.ts",
      "default": "./src/tree.ts"
    },
    "./tree-lazy": {
      "types": "./src/tree-lazy.ts",
      "default": "./src/tree-lazy.ts"
    },
    "./detail": {
      "types": "./src/detail.ts",
      "default": "./src/detail.ts"
    }
  }
}
