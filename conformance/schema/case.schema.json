{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DzGrid conformance case",
  "type": "object",
  "required": ["id", "suite", "description", "input", "expected"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "suite": { "type": "string" },
    "description": { "type": "string" },
    "refs": { "type": "array", "items": { "type": "string" } },
    "input": {
      "description": "The suite's input. `now` (optional): the clock, ISO UTC (`2026-10-19T10:00:00Z`), for relative date filters (docs/behaviors/filter-relative.md); absent means no clock.",
      "type": "object",
      "properties": { "now": { "type": "string", "pattern": "Z$" } }
    },
    "expected": {}
  }
}
