{
  "id": "sp-longer-list-refused",
  "suite": "server-pivot",
  "description": "A server that sends more crossings than the limit anyway: the grid counts them and refuses the same way — no created column, no cell read. The export's crossings are the screen's columns: none.",
  "refs": [
    "docs/behaviors/server-pivot.md"
  ],
  "input": {
    "pivot": {
      "by": [
        "region"
      ],
      "columns": [
        "year"
      ],
      "values": {
        "amount": "sum"
      },
      "maxColumns": 2
    },
    "steps": [
      {
        "answer": "c1",
        "response": {
          "groups": [
            {
              "value": "Nord",
              "count": 3,
              "aggs": {
                "amount": 6
              },
              "cells": {
                "0": {
                  "amount": 1
                },
                "1": {
                  "amount": 2
                },
                "2": {
                  "amount": 3
                }
              }
            }
          ],
          "total": 1,
          "pivot": {
            "crossings": [
              [
                2024
              ],
              [
                2025
              ],
              [
                2026
              ]
            ]
          }
        }
      }
    ]
  },
  "expected": {
    "calls": [
      [
        "c1",
        [],
        {
          "columns": [
            "year"
          ],
          "limit": 2
        },
        []
      ]
    ],
    "told": [
      "pivot-too-many pivot.columns 3"
    ],
    "final": {
      "columns": [],
      "count": 3,
      "rows": [
        [
          "Nord",
          {
            "amount": 6
          }
        ]
      ],
      "problems": [
        "pivot-too-many pivot.columns 3"
      ],
      "aggs": [
        {
          "column": "amount",
          "fn": "sum"
        }
      ],
      "export": {
        "columns": [
          "year"
        ],
        "limit": 2,
        "crossings": []
      }
    }
  }
}
