{
  "id": "sp-limit-count",
  "suite": "server-pivot",
  "description": "Above the limit (maxColumns 4, two values: 2 crossings), the server sends the count alone: no created column, the groups keep their row totals, told by the number of columns (crossings × values), never a value (owner Q-SP4 A).",
  "refs": [
    "docs/behaviors/server-pivot.md"
  ],
  "input": {
    "pivot": {
      "by": [
        "region"
      ],
      "columns": [
        "year"
      ],
      "values": {
        "amount": "sum",
        "visits": "count"
      },
      "maxColumns": 4
    },
    "steps": [
      {
        "answer": "c1",
        "response": {
          "groups": [
            {
              "value": "Nord",
              "count": 1,
              "aggs": {
                "amount": 5,
                "visits": 1
              },
              "cells": {
                "0": {
                  "amount": 5
                }
              }
            }
          ],
          "total": 1,
          "pivot": {
            "count": 7
          }
        }
      }
    ]
  },
  "expected": {
    "calls": [
      [
        "c1",
        [],
        {
          "columns": [
            "year"
          ],
          "limit": 2
        },
        []
      ]
    ],
    "told": [
      "pivot-too-many pivot.columns 14"
    ],
    "final": {
      "columns": [],
      "count": 14,
      "rows": [
        [
          "Nord",
          {
            "amount": 5,
            "visits": 1
          }
        ]
      ],
      "problems": [
        "pivot-too-many pivot.columns 14"
      ],
      "aggs": [
        {
          "column": "amount",
          "fn": "sum"
        },
        {
          "column": "visits",
          "fn": "count"
        }
      ],
      "export": {
        "columns": [
          "year"
        ],
        "limit": 2,
        "crossings": []
      }
    }
  }
}
