{
  "id": "group-outline",
  "suite": "xlsx",
  "description": "Grouped, `all`, footers and grand total with the grid's labels: the group row above its rows (summary above), rows and footer one level deeper, totals typed (a currency sum, a day as a date), a count a plain number (xlsx-export.md « Grouped rows » 1–3).",
  "refs": [
    "docs/behaviors/xlsx-export.md"
  ],
  "input": {
    "locale": "fr-FR",
    "labels": true,
    "scope": "all",
    "grouping": {
      "by": [
        "ward"
      ],
      "footers": "both"
    },
    "columns": [
      {
        "id": "ward",
        "header": "Ward"
      },
      {
        "id": "name",
        "header": "Name",
        "aggFunc": "count"
      },
      {
        "id": "amount",
        "header": "Amount",
        "type": "number",
        "aggFunc": "sum",
        "numberFormat": {
          "style": "currency",
          "currency": "EUR"
        }
      },
      {
        "id": "seen",
        "header": "Seen",
        "type": "day",
        "aggFunc": "min"
      }
    ],
    "rows": [
      {
        "id": "r0",
        "ward": "Alger",
        "name": "a",
        "amount": 1.5,
        "seen": "2026-03-05"
      },
      {
        "id": "r1",
        "ward": "Oran",
        "name": "b",
        "amount": 2,
        "seen": "2026-01-09"
      },
      {
        "id": "r2",
        "ward": "Alger",
        "name": "c",
        "amount": 2.25,
        "seen": "2026-02-01"
      }
    ]
  },
  "expected": {
    "cells": {
      "A1": "Ward",
      "B1": "Name",
      "C1": "Amount",
      "D1": "Seen",
      "A2": "Alger (2)",
      "B2": 2,
      "C2": 3.75,
      "D2": 46054,
      "A3": "Alger",
      "B3": "a",
      "C3": 1.5,
      "D3": 46086,
      "A4": "Alger",
      "B4": "c",
      "C4": 2.25,
      "D4": 46054,
      "A5": "Total Alger",
      "B5": 2,
      "C5": 3.75,
      "D5": 46054,
      "A6": "Oran (1)",
      "B6": 1,
      "C6": 2,
      "D6": 46031,
      "A7": "Oran",
      "B7": "b",
      "C7": 2,
      "D7": 46031,
      "A8": "Total Oran",
      "B8": 1,
      "C8": 2,
      "D8": 46031,
      "A9": "Total",
      "B9": 3,
      "C9": 5.75,
      "D9": 46031
    },
    "outline": {
      "3": 1,
      "4": 1,
      "5": 1,
      "7": 1,
      "8": 1
    },
    "indent": {
      "A3": 1,
      "A4": 1,
      "A5": 1,
      "A7": 1,
      "A8": 1
    },
    "summaryBelow": false,
    "formats": {
      "C2": "#,##0.00\\ \"€\"",
      "D2": "14",
      "C3": "#,##0.00\\ \"€\"",
      "D3": "14",
      "C4": "#,##0.00\\ \"€\"",
      "D4": "14",
      "C5": "#,##0.00\\ \"€\"",
      "D5": "14",
      "C6": "#,##0.00\\ \"€\"",
      "D6": "14",
      "C7": "#,##0.00\\ \"€\"",
      "D7": "14",
      "C8": "#,##0.00\\ \"€\"",
      "D8": "14",
      "C9": "#,##0.00\\ \"€\"",
      "D9": "14"
    },
    "summary": {
      "rows": 8,
