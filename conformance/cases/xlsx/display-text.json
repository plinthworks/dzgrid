{
  "id": "display-text",
  "suite": "xlsx",
  "description": "text display: every cell a text cell as the grid shows it.",
  "input": {
    "locale": "en-US",
    "columns": [
      {
        "id": "n",
        "header": "N",
        "type": "number",
        "numberFormat": {
          "minimumFractionDigits": 2,
          "maximumFractionDigits": 2
        }
      },
      {
        "id": "d",
        "header": "D",
        "type": "day"
      }
    ],
    "rows": [
      {
        "n": 1234.5,
        "d": "2026-03-05"
      }
    ],
    "options": {
      "text": "display"
    }
  },
  "expected": {
    "cells": {
      "A1": "N",
      "B1": "D",
      "A2": "1,234.50",
      "B2": "03/05/2026"
    },
    "formats": {}
  }
}
