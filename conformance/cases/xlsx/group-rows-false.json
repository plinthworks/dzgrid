{
  "id": "group-rows-false",
  "suite": "xlsx",
  "description": "`groupRows: false`: data rows only, no outline (« Grouped rows » 4).",
  "refs": [
    "docs/behaviors/xlsx-export.md"
  ],
  "input": {
    "locale": "en-US",
    "scope": "all",
    "grouping": {
      "by": [
        "ward"
      ],
      "footers": "both"
    },
    "columns": [
      {
        "id": "ward",
        "header": "Ward"
      },
      {
        "id": "name",
        "header": "Name",
        "aggFunc": "count"
      },
      {
        "id": "amount",
        "header": "Amount",
        "type": "number",
        "aggFunc": "sum",
        "numberFormat": {
          "style": "currency",
          "currency": "EUR"
        }
      }
    ],
    "rows": [
      {
        "id": "r0",
        "ward": "Alger",
        "name": "a",
        "amount": 1.5,
        "seen": "2026-03-05"
      },
      {
        "id": "r1",
        "ward": "Oran",
        "name": "b",
        "amount": 2,
        "seen": "2026-01-09"
      },
      {
        "id": "r2",
        "ward": "Alger",
        "name": "c",
        "amount": 2.25,
        "seen": "2026-02-01"
      }
    ],
    "options": {
      "groupRows": false
    }
  },
  "expected": {
    "cells": {
      "A1": "Ward",
      "B1": "Name",
      "C1": "Amount",
      "A2": "Alger",
      "B2": "a",
      "C2": 1.5,
      "A3": "Alger",
      "B3": "c",
      "C3": 2.25,
      "A4": "Oran",
      "B4": "b",
      "C4": 2
    },
    "outline": {},
    "summary": {
      "rows": 3,
      "columns": 3,
      "blank": 0,
      "invalid": 0
    },
    "problems": []
  }
}
