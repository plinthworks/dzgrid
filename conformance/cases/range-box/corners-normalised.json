{
  "id": "corners-normalised",
  "suite": "range-box",
  "description": "The anchor below and after the focus gives the same box: top <= bottom, start <= end.",
  "input": {
    "shown": [
      "r1",
      "r2",
      "r3",
      "r4",
      "r5"
    ],
    "columns": [
      {
        "id": "a"
      },
      {
        "id": "b"
      },
      {
        "id": "c"
      },
      {
        "id": "d"
      }
    ],
    "range": {
      "anchor": [
        "r4",
        "c"
      ],
      "focus": [
        "r2",
        "a"
      ]
    }
  },
  "expected": {
    "box": {
      "top": 1,
      "bottom": 3,
      "start": 0,
      "end": 2
    },
    "rows": [
      "r2",
      "r3",
      "r4"
    ],
    "columns": [
      "a",
      "b",
      "c"
    ],
    "size": {
      "rows": 3,
      "cols": 3,
      "cells": 9
    }
  }
}
