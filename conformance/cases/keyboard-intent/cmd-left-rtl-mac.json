{
  "id": "cmd-left-rtl-mac",
  "suite": "keyboard-intent",
  "description": "On a Mac in RTL, Cmd+ArrowLeft goes to the last column.",
  "input": {
    "key": "ArrowLeft",
    "dir": "rtl",
    "owner": "cell",
    "mac": true,
    "ctrl": false,
    "meta": true,
    "shift": false,
    "alt": false
  },
  "expected": {
    "intent": {
      "kind": "edge",
