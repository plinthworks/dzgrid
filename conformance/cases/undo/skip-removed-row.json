        "refused": []
      },
      {
        "cells": [],
        "skipped": 1
      }
    ],
    "requests": [
      {
        "generation": 1,
        "origin": "edit",
        "changes": [
          [
            "a",
            "v",
            5,
            1
          ]
        ],
        "rows": [
          [
            "a",
            true
          ]
        ]
      }
    ],
    "canUndo": false,
    "canRedo": true
  }
}
