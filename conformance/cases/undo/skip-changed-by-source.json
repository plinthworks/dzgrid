{
  "id": "skip-changed-by-source",
  "suite": "undo",
  "description": "A cell the source changed since is skipped and counted; the others are undone.",
  "input": {
    "columns": [
      {
        "id": "v",
        "type": "number",
        "editable": true
      },
      {
        "id": "w",
        "type": "number",
        "editable": true
      },
      {
        "id": "n",
        "editable": true
      }
    ],
    "rows": [
      {
        "id": "a",
        "v": 1,
        "w": 10,
        "n": "x"
      },
      {
        "id": "b",
        "v": 2,
        "w": 20,
        "n": "y"
      },
      {
        "id": "c",
        "v": 3,
        "w": 30,
        "n": "z"
      }
    ],
    "steps": [
      {
        "commit": [
          [
            "a",
            "v",
            5
          ],
          [
            "b",
            "v",
            6
          ]
        ]
      },
      {
        "ok": 1
      },
      {
        "tx": {
          "update": [
            {
              "id": "a",
              "v": 9,
              "w": 10,
              "n": "x"
            }
          ]
        }
      },
      {
        "undo": true
      }
    ]
  },
  "expected": {
    "results": [
      {
        "generation": 1,
        "staged": 2,
        "refused": []
      },
      {
        "cells": [
          [
            "b",
            "v"
          ]
        ],
        "skipped": 1
      }
    ],
    "requests": [
      {
        "generation": 1,
        "origin": "edit",
        "changes": [
          [
            "a",
            "v",
            5,
            1
          ],
          [
            "b",
            "v",
            6,
            2
          ]
        ],
        "rows": [
          [
            "a",
            true
          ],
          [
            "b",
            true
          ]
        ]
      },
      {
        "generation": 2,
        "origin": "undo",
        "changes": [
          [
            "b",
            "v",
            2,
            6
          ]
        ],
        "rows": [
          [
            "b",
            true
          ]
        ]
      }
    ]
  }
}
