{
  "id": "relative-yesterday-sao-paulo-no-midnight",
  "suite": "filter-instant",
  "description": "Yesterday in São Paulo was 4 November 2018, which had no midnight: it starts at 01:00 (-02), 03:00Z.",
  "refs": [
    "docs/behaviors/filter-relative.md"
  ],
  "input": {
    "locale": "fr-FR",
    "timeZone": "America/Sao_Paulo",
    "columns": [
      {
        "id": "t",
        "type": "instant"
      }
    ],
    "rows": [
      {
        "id": "1",
        "t": "2018-11-04T02:59:59.999Z"
      },
      {
        "id": "2",
        "t": "2018-11-04T03:00:00Z"
      },
      {
        "id": "3",
        "t": "2018-11-05T01:59:59.999Z"
      },
      {
        "id": "4",
        "t": "2018-11-05T02:00:00Z"
      }
    ],
    "filter": {
      "t": {
        "type": "instant",
        "op": "relative",
        "range": "yesterday"
      }
    },
    "now": "2018-11-05T12:00:00Z"
  },
  "expected": {
    "ids": [
      "2",
      "3"
    ]
  }
}
