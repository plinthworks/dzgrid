{
  "id": "retry-gets-a-new-seq",
  "suite": "server-gate",
  "description": "A retry after a failure is a new request with a new number.",
  "input": {
    "steps": [
      {
        "op": "begin",
        "channel": "rows",
        "key": "k",
        "as": "a"
      },
      {
        "op": "reject",
        "ticket": "a"
      },
      {
        "op": "begin",
        "channel": "rows",
        "key": "k",
        "as": "b"
      },
      {
        "op": "settle",
        "ticket": "b"
      }
    ]
  },
  "expected": {
    "outcomes": [
      {
        "seq": 1,
        "epoch": 0
      },
      null,
      {
        "seq": 2,
        "epoch": 0
      },
      null
    ],
    "aborted": [],
    "diagnostics": {
      "begun": 2,
      "accepted": 2,
      "dropped": {
        "superseded": 0,
        "stale-epoch": 0,
        "aborted": 0,
        "destroyed": 0
      }
    }
  }
}