{
  "id": "stale-rejection-is-dropped",
  "suite": "server-gate",
  "description": "A stale request that fails is dropped, never shown as an error.",
  "input": {
    "steps": [
      {
        "op": "begin",
        "channel": "rows",
        "key": "p1",
        "as": "a"
      },
      {
        "op": "begin",
        "channel": "rows",
        "key": "p2",
        "as": "b"
      },
      {
        "op": "reject",
        "ticket": "a"
      },
      {
        "op": "reject",
        "ticket": "b"
      }
    ]
  },
  "expected": {
    "outcomes": [
      {
        "seq": 1,
        "epoch": 0
      },
      {
        "seq": 2,
        "epoch": 0
      },
      "superseded",
      null
    ],
    "aborted": [
      [
        "a",
        "superseded"
      ]
    ],
    "diagnostics": {
      "begun": 2,
      "accepted": 1,
      "dropped": {
        "superseded": 1,
        "stale-epoch": 0,
        "aborted": 0,
        "destroyed": 0
      }
    }
  }
}