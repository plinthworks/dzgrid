{
  "id": "set-include-only-include",
  "suite": "filter-combined",
  "description": "On an include-only set column, an include applies as on any column: the ticked values, no blank.",
  "input": {
    "locale": "fr-FR",
    "columns": [
      {
        "id": "s",
        "filter": {
          "kind": "set",
          "exclude": false
        }
      }
    ],
    "rows": [
      {
        "id": "1",
        "s": "A"
      },
      {
        "id": "2",
        "s": "B"
      },
      {
        "id": "3",
        "s": null
      }
    ],
    "filter": {
      "s": {
        "type": "set",
        "include": [
          "B"
        ]
      }
    }
  },
  "expected": {
    "ids": [
      "2"
    ]
  }
}
