{
  "id": "multi-set-and-number-between",
  "suite": "filter-combined",
  "description": "A between condition and a value list on a number column: the list matches raw text.",
  "input": {
    "locale": "en-US",
    "columns": [
      {
        "id": "v",
        "type": "number"
      }
    ],
    "rows": [
      {
        "id": "1",
        "v": 1
      },
      {
        "id": "2",
        "v": 5
      },
      {
        "id": "3",
        "v": 10
      },
      {
        "id": "4",
        "v": null
      },
      {
        "id": "5",
        "v": 7.5
      },
      {
        "id": "6",
        "v": 12
      }
    ],
    "filter": {
      "v": {
        "type": "combined",
        "join": "and",
        "conditions": [
          {
            "type": "number",
            "op": "between",
            "value": 5,
            "valueTo": 12
          },
          {
            "type": "set",
            "exclude": [
              "10"
            ]
          }
        ]
      }
    }
  },
  "expected": {
    "ids": [
      "2",
      "5",
      "6"
    ]
  }
}
