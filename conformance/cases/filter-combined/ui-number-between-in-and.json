{
  "id": "ui-number-between-in-and",
  "suite": "filter-combined",
  "description": "A between row and a not-equal row joined by AND.",
  "input": {
    "locale": "en-US",
    "columns": [
      {
        "id": "v",
        "type": "number"
      }
    ],
    "rows": [
      {
        "id": "1",
        "v": 1
      },
      {
        "id": "2",
        "v": 5
      },
      {
        "id": "3",
        "v": 10
      },
      {
        "id": "4",
        "v": null
      },
      {
        "id": "5",
        "v": 7.5
      },
      {
        "id": "6",
        "v": 12
      }
    ],
    "filter": {
      "v": {
        "type": "combined",
        "join": "and",
        "conditions": [
          {
            "type": "number",
            "op": "between",
            "value": 2,
            "valueTo": 11
          },
          {
            "type": "number",
            "op": "notEqual",
            "value": 5
          }
        ]
      }
    }
  },
  "expected": {
    "ids": [
      "3",
      "5"
    ]
  }
}
