{
  "id": "detail-and-loading",
  "suite": "range-stats",
  "description": "A detail row and a loading row inside the box count for nothing; the loading row makes the figures partial.",
  "input": {
    "shown": ["r1", "> r1", "r2", "~r2", "r3"],
    "columns": [{ "id": "a", "type": "number" }],
    "rows": { "r1": { "a": 1 }, "r2": { "a": 2 }, "r3": { "a": 3 } },
    "range": { "anchor": ["r1", "a"], "focus": ["r3", "a"] }
  },
  "expected": {
    "stats": { "cells": 3, "filled": 3, "numbers": 3, "sum": 6, "min": 1, "max": 3, "partial": true, "formats": [{}] }
  }
}
