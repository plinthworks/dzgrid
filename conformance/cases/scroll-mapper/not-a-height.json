{
  "id": "not-a-height",
  "suite": "scroll-mapper",
  "description": "A height that is not a number is no height.",
  "input": {
    "logical": "NaN",
    "maxPhysical": 4000000,
    "view": 600,
    "toLogical": [
      100
    ]
  },
  "expected": {
    "scaled": false,
    "maxLogical": 0,
    "toLogical": [
      0
    ]
  }
}
