{
  "id": "formula-guard",
  "suite": "csv",
  "description": "Every text field that starts a formula gets a leading quote; the typed number -5 does not.",
  "input": {
    "locale": "en-US",
    "columns": [
      {
        "id": "t",
        "header": "=T"
      },
      {
        "id": "n",
        "header": "N",
        "type": "number"
      }
    ],
    "rows": [
      {
        "t": "=1+1",
        "n": -5
      },
      {
        "t": "+33 6",
        "n": 1
      },
      {
        "t": "@SUM(A1)",
        "n": 2
      },
      {
        "t": " -x",
        "n": 3
      },
      {
        "t": "\u200f=cmd",
        "n": 4
      },
      {
        "t": "\tx",
        "n": 5
      },
      {
        "t": "12-3",
        "n": 6
      },
      {
        "t": "a=b",
        "n": 7
      }
    ],
    "options": {
      "bom": false
    }
  },
  "expected": {
    "text": "'=T,N\r\n'=1+1,-5\r\n'+33 6,1\r\n'@SUM(A1),2\r\n' -x,3\r\n'\u200f=cmd,4\r\n'\tx,5\r\n12-3,6\r\na=b,7\r\n",
    "summary": {
      "rows": 8,
      "columns": 2,
      "blank": 0,
      "invalid": 0
    }
  }
}
