{
  "id": "group-labels-footers-all",
  "suite": "csv",
  "description": "`all` with the grid's labels: every group open, a footer per group and the grand total last; French decimals (« Grouped rows » 1–3).",
  "refs": [
    "docs/behaviors/csv-export.md"
  ],
  "input": {
    "locale": "fr-FR",
    "labels": true,
    "scope": "all",
    "grouping": {
      "by": [
        "ward"
      ],
      "footers": "both"
    },
    "columns": [
      {
        "id": "ward",
        "header": "Ward"
      },
      {
        "id": "name",
        "header": "Name",
        "aggFunc": "count"
      },
      {
        "id": "amount",
        "header": "Amount",
        "type": "number",
        "aggFunc": "sum"
      }
    ],
    "rows": [
      {
        "id": "r0",
        "ward": "Alger",
        "name": "a",
        "amount": 1.5
      },
      {
        "id": "r1",
        "ward": "Oran",
        "name": "b",
        "amount": 2
      },
      {
        "id": "r2",
        "ward": "Alger",
        "name": "c",
        "amount": 2.25
      }
    ],
    "options": {
      "bom": false
    }
  },
  "expected": {
    "text": "Level;Ward;Name;Amount\r\n1;Alger (2);2;3,75\r\n2;Alger;a;1,5\r\n2;Alger;c;2,25\r\n2;Total Alger;2;3,75\r\n1;Oran (1);1;2\r\n2;Oran;b;2\r\n2;Total Oran;1;2\r\n1;Total;3;5,75\r\n",
    "summary": {
      "rows": 8,
      "columns": 3,
      "blank": 0,
      "invalid": 0
    }
  }
}
