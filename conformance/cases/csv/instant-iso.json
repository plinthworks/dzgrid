{
  "id": "instant-iso",
  "suite": "csv",
  "description": "instants iso: UTC with Z, milliseconds when not zero, the header unchanged.",
  "input": {
    "locale": "fr-FR",
    "timeZone": "Africa/Algiers",
    "columns": [
      {
        "id": "at",
        "header": "Date",
        "type": "instant"
      }
    ],
    "rows": [
      {
        "at": "2026-03-05T22:59:00Z"
      },
      {
        "at": "2026-03-05T23:00:00.999Z"
      }
    ],
    "options": {
      "bom": false,
      "instants": "iso"
    }
  },
  "expected": {
    "text": "Date\r\n2026-03-05T22:59:00Z\r\n2026-03-05T23:00:00.999Z\r\n",
    "summary": {
      "rows": 2,
      "columns": 1,
      "blank": 0,
      "invalid": 0
    }
  }
}
