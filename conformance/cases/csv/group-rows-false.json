{
  "id": "group-rows-false",
  "suite": "csv",
  "description": "`groupRows: false`: the data rows only, flat, no level column; `displayed` writes the rows of the open groups (« Grouped rows » 5).",
  "refs": [
    "docs/behaviors/csv-export.md"
  ],
  "input": {
    "locale": "en-US",
    "grouping": {
      "by": [
        "ward"
      ],
      "footers": "both"
    },
    "open": [
      [
        "ward",
        "tAlger"
      ]
    ],
    "columns": [
      {
        "id": "ward",
        "header": "Ward"
      },
      {
        "id": "name",
        "header": "Name",
        "aggFunc": "count"
      },
      {
        "id": "amount",
        "header": "Amount",
        "type": "number",
        "aggFunc": "sum"
      }
    ],
    "rows": [
      {
        "id": "r0",
        "ward": "Alger",
        "name": "a",
        "amount": 1.5
      },
      {
        "id": "r1",
        "ward": "Oran",
        "name": "b",
        "amount": 2
      },
      {
        "id": "r2",
        "ward": "Alger",
        "name": "c",
        "amount": 2.25
      }
    ],
    "options": {
      "bom": false,
      "groupRows": false
    }
  },
  "expected": {
    "text": "Ward,Name,Amount\r\nAlger,a,1.5\r\nAlger,c,2.25\r\n",
    "summary": {
      "rows": 2,
      "columns": 3,
      "blank": 0,
      "invalid": 0
    }
  }
}
