{
  "id": "filter-removes",
  "suite": "pivot",
  "description": "A filter that keeps no row of a crossing removes its column (pivot.md 6).",
  "refs": [
    "docs/behaviors/pivot.md"
  ],
  "input": {
    "columns": [
      {
        "id": "g"
      },
      {
        "id": "y"
      },
      {
        "id": "m"
      },
      {
        "id": "v",
        "type": "number",
        "aggFunc": "sum"
      }
    ],
    "rows": [
      {
        "id": "r1",
        "g": "Nord",
        "y": "2025",
        "m": "Jan",
        "v": 10
      },
      {
        "id": "r2",
        "g": "Nord",
        "y": "2025",
        "m": "Feb",
        "v": 5
      },
      {
        "id": "r3",
        "g": "Sud",
        "y": "2025",
        "m": "Jan",
        "v": 2
      },
      {
        "id": "r4",
        "g": "Nord",
        "y": "2026",
        "m": "Jan",
        "v": 1
      },
      {
        "id": "r5",
        "g": "Sud",
        "y": "2026",
        "m": "Jan",
        "v": 4
      },
      {
        "id": "r6",
        "g": "Nord",
        "y": "2025",
        "m": "Jan",
        "v": 3
      }
    ],
    "pivot": {
      "by": [
        "g"
      ],
      "columns": [
        "y",
        "m"
      ]
    },
    "steps": [
      {
        "filter": {
          "y": {
            "type": "set",
            "exclude": [
              "2026"
            ]
          }
        }
      }
    ]
  },
  "expected": {
    "headers": [
      "2025/Feb",
      "2025/Jan"
    ],
    "shown": [
      "[Nord] (3) 1/3 {2025/Feb=5 2025/Jan=13 | v=18}",
      "[Sud] (1) 2/3 {2025/Jan=2 | v=2}",
      "Σ* 3/3 {2025/Feb=5 2025/Jan=15 | v=20}"
    ],
    "count": 2,
    "problems": []
  }
}
