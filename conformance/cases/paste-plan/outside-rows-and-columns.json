      "r1",
      "r2",
      "r3",
      "r4",
      "r5"
    ],
    "columns": [
      {
        "id": "a"
      },
      {
        "id": "b"
      },
      {
        "id": "c"
      },
      {
        "id": "d"
      }
    ],
    "src": [
      [
        "1",
        "2",
        "3"
      ],
      [
        "4",
        "5",
        "6"
      ]
    ],
    "at": {
      "top": 4,
      "bottom": 4,
      "start": 2,
      "end": 2
    }
