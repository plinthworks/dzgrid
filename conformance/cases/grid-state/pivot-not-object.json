          "pinned": null
        },
        {
          "id": "month",
          "order": 1,
          "pinned": null
        },
        {
          "id": "amount",
          "order": 2,
          "pinned": null
        },
        {
          "id": "code",
          "order": 3,
          "pinned": null
        }
      ],
      "sort": [],
      "filter": {},
      "quick": "",
      "rowGroups": [
        "ward"
      ],
      "pivot": {
        "on": true,
        "columns": [
          "month"
        ],
        "values": {
          "amount": "sum"
        }
      }
    },
    "shown": [
      "[N]",
      "[S]",
      "Σ"
    ],
    "by": [
      "ward"
    ]
