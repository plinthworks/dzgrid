{
  "id": "pivot-not-object",
  "suite": "grid-state",
  "description": "A `pivot` that is not an object: told at `pivot`, the grid's pivot kept (grid-state.md « Pivot » 3).",
  "refs": [
    "docs/behaviors/grid-state.md",
    "docs/behaviors/pivot.md"
  ],
  "input": {
    "columns": [
      {
        "id": "ward",
        "header": "Ward"
      },
      {
        "id": "month",
        "header": "Month"
      },
      {
        "id": "amount",
        "type": "number",
        "aggFunc": "sum"
      },
      {
        "id": "code",
        "groupable": false
      }
    ],
    "rows": [
      {
        "id": "r1",
        "ward": "N",
        "month": "Jan",
        "amount": 1
      },
      {
        "id": "r2",
        "ward": "S",
        "month": "Feb",
        "amount": 2
      }
    ],
    "pivot": {
