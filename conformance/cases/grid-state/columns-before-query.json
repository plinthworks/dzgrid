{
  "id": "columns-before-query",
  "suite": "grid-state",
  "description": "Columns are restored before the query: a sort on a column the state shows again (the user had hidden it) sorts the rows (G 6, plan risk 3).",
  "refs": [
    "docs/behaviors/grid-state.md"
  ],
  "input": {
    "columns": [
      {
        "id": "name"
      },
      {
        "id": "age",
        "type": "number"
      },
      {
        "id": "city"
      }
    ],
    "rows": [
      {
        "id": "r1",
        "name": "Amel",
        "age": 40,
        "city": "Oran"
      },
      {
        "id": "r2",
        "name": "Bilal",
        "age": 25,
        "city": "Oran"
      },
      {
        "id": "r3",
        "name": "Chems",
        "age": 33,
        "city": "Orléans"
      },
      {
        "id": "r4",
        "name": "Dalia",
        "age": 51,
        "city": "Oran"
      },
      {
        "id": "r5",
        "name": "Elias",
        "age": 19,
        "city": "Oran"
      }
    ],
    "before": [
      {
        "type": "column.state",
        "patch": [
          {
            "id": "age",
            "hidden": true
          }
        ]
      }
    ],
    "restore": {
      "v": 1,
      "columns": [
        {
          "id": "name",
          "pinned": null,
          "order": 0
        },
        {
          "id": "age",
          "pinned": null,
          "order": 1
        },
        {
          "id": "city",
          "pinned": null,
          "order": 2
        }
      ],
      "sort": [
        {
          "column": "age",
          "dir": "asc"
        }
      ]
    }
  },
  "expected": {
    "problems": [],
    "state": {
      "v": 1,
      "columns": [
        {
          "id": "name",
          "order": 0,
          "pinned": null
        },
        {
          "id": "age",
          "order": 1,
          "pinned": null
        },
        {
          "id": "city",
          "order": 2,
          "pinned": null
        }
      ],
      "sort": [
        {
          "column": "age",
          "dir": "asc"
        }
      ],
      "filter": {},
      "quick": ""
    },
    "shown": [
      "r5",
      "r2",
      "r3",
      "r1",
      "r4"
    ]
  }
}
