      "columns": [
        {
          "id": "ward",
          "order": 0,
          "pinned": null
        },
        {
          "id": "name",
          "order": 1,
          "pinned": null
        },
        {
          "id": "amount",
          "order": 2,
          "pinned": null
        }
      ],
      "sort": [],
      "filter": {},
      "quick": "",
      "rowGroups": [
        "ward"
      ],
      "pivot": {
        "on": true,
        "columns": [
          "name"
        ],
        "values": {
          "amount": "sum"
        }
      }
    },
    "leaks": false,
