{
  "id": "number-blank",
  "suite": "filter-number",
  "description": "An unreadable cell counts as blank.",
  "input": {
    "locale": "en-US",
    "columns": [
      {
        "id": "v",
        "type": "number"
      }
    ],
    "rows": [
      {
        "id": "1",
        "v": 1
      },
      {
        "id": "2",
        "v": 5
      },
      {
        "id": "3",
        "v": 10
      },
      {
        "id": "4",
        "v": null
      },
      {
        "id": "5",
        "v": "abc"
      },
      {
        "id": "6",
        "v": 7.5
      }
    ],
    "filter": {
      "v": {
        "type": "number",
        "op": "blank"
      }
    }
  },
  "expected": {
    "ids": [
      "4",
      "5"
    ]
  }
}
