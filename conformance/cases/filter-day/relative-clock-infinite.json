{
  "id": "relative-clock-infinite",
  "suite": "filter-day",
  "description": "A clock that reads Infinity is no clock: refused, never a throw, the filter ignored.",
  "refs": [
    "docs/behaviors/filter-relative.md"
  ],
  "input": {
    "locale": "fr-FR",
    "timeZone": "UTC",
    "columns": [
      {
        "id": "d",
        "type": "day"
      }
    ],
    "rows": [
      {
        "id": "1",
        "d": "2026-10-19"
      },
      {
        "id": "2",
        "d": "2026-10-20"
      }
    ],
    "filter": {
      "d": {
        "type": "day",
        "op": "relative",
        "range": "last30Days"
      }
    },
    "now": "Infinity"
  },
  "expected": {
    "ids": [
      "1",
      "2"
    ],
    "problems": [
      [
        "invalid-filter",
        "filter.d"
      ]
    ]
  }
}
