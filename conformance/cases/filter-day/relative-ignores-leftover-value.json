{
  "id": "relative-ignores-leftover-value",
  "suite": "filter-day",
  "description": "A shortcut reads its range only: a value and valueTo left from another op (even ones that are no day) are ignored, no problem.",
  "refs": [
    "docs/behaviors/filter-relative.md"
  ],
  "input": {
    "locale": "fr-FR",
    "timeZone": "UTC",
    "columns": [
      {
        "id": "d",
        "type": "day"
      }
    ],
    "rows": [
      {
        "id": "1",
        "d": "2026-10-18"
      },
      {
        "id": "2",
        "d": "2026-10-19"
      },
      {
        "id": "3",
        "d": "2026-10-20"
      }
    ],
    "filter": {
      "d": {
        "type": "day",
        "op": "relative",
        "range": "today",
        "value": "not a day",
        "valueTo": "2026-02-30"
      }
    },
    "now": "2026-10-19T10:00:00Z"
  },
  "expected": {
    "ids": [
      "2"
    ]
  }
}
