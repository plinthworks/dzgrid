{
  "id": "relative-today",
  "suite": "filter-day",
  "description": "Today is the day the clock reads in the grid's zone: 23:30Z on the 18th is already the 19th in Algiers.",
  "refs": [
    "docs/behaviors/filter-relative.md"
  ],
  "input": {
    "locale": "fr-FR",
    "timeZone": "Africa/Algiers",
    "columns": [
      {
        "id": "d",
        "type": "day"
      }
    ],
    "rows": [
      {
        "id": "1",
        "d": "2026-10-18"
      },
      {
        "id": "2",
        "d": "2026-10-19"
      },
      {
        "id": "3",
        "d": "2026-10-20"
      },
      {
        "id": "4",
        "d": null
      }
    ],
    "filter": {
      "d": {
        "type": "day",
        "op": "relative",
        "range": "today"
      }
    },
    "now": "2026-10-18T23:30:00Z"
  },
  "expected": {
    "ids": [
      "2"
    ]
  }
}
