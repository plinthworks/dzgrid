{
  "id": "relative-last7days-month-boundary",
  "suite": "filter-day",
  "description": "The last 7 days include today and reach back across the end of February: 25 February to 3 March.",
  "refs": [
    "docs/behaviors/filter-relative.md"
  ],
  "input": {
    "locale": "fr-FR",
    "timeZone": "UTC",
    "columns": [
      {
        "id": "d",
        "type": "day"
      }
    ],
    "rows": [
      {
        "id": "1",
        "d": "2026-02-24"
      },
      {
        "id": "2",
        "d": "2026-02-25"
      },
      {
        "id": "3",
        "d": "2026-03-03"
      },
      {
        "id": "4",
        "d": "2026-03-04"
      }
    ],
    "filter": {
      "d": {
        "type": "day",
        "op": "relative",
        "range": "last7Days"
      }
    },
    "now": "2026-03-03T08:00:00Z"
  },
  "expected": {
    "ids": [
      "2",
      "3"
    ]
  }
}
