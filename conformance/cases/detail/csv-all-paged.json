        "id": "a",
        "n": 3,
        "t": "ward"
      },
      {
        "id": "b",
        "n": 1,
        "t": "bed"
      },
      {
        "id": "c",
        "n": 2,
        "t": "ward"
      },
      {
        "id": "d",
        "n": 5,
        "t": "bed"
      },
      {
        "id": "e",
        "n": 4,
        "t": "ward"
      }
