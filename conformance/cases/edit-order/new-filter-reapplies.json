{
  "id": "new-filter-reapplies",
  "suite": "edit-order",
  "description": "Sorted by v, d edited to 99: a new filter runs everything again with the edit.",
  "input": {
    "columns": [
      {
        "id": "v",
        "type": "number"
      },
      {
        "id": "n"
      }
    ],
    "rows": [
      {
        "id": "a",
        "v": 3,
        "n": "x"
      },
      {
        "id": "b",
        "v": 1,
        "n": "y"
      },
      {
        "id": "c",
        "v": 2,
        "n": "x"
      },
      {
        "id": "d",
        "v": 0,
        "n": "y"
      }
    ],
    "query": {
      "sort": [
        {
          "column": "v",
          "dir": "asc"
        }
      ]
    },
    "steps": [
      {
        "edit": [
          "d",
          "v",
          99
        ]
      },
      {
        "filter": {
          "n": {
            "type": "text",
            "op": "equals",
            "value": "y"
          }
        }
      }
    ]
  },
  "expected": {
    "shown": [
      "b",
      "d"
    ],
    "stale": [
      true,
      false
    ],
    "changes": [
      [
        "query",
        "user"
      ]
    ]
  }
}
