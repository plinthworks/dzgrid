{
  "id": "tree-sorted-edit-before-reapply",
  "suite": "edit-order",
  "description": "A tree sorted by v, all open: right after the edit, the child keeps its place.",
  "input": {
    "columns": [
      {
        "id": "v",
        "type": "number"
      },
      {
        "id": "n"
      }
    ],
    "rows": [
      {
        "id": "r",
        "p": null,
        "v": 5,
        "n": "r"
      },
      {
        "id": "x",
        "p": "r",
        "v": 1,
        "n": "x"
      },
      {
        "id": "y",
        "p": "r",
        "v": 2,
        "n": "y"
      },
      {
        "id": "s",
        "p": null,
        "v": 1,
        "n": "s"
      }
    ],
    "shape": "tree",
    "tree": {
      "initial": "all"
    },
    "query": {
      "sort": [
        {
          "column": "v",
          "dir": "asc"
        }
      ]
    },
    "steps": [
      {
        "edit": [
          "x",
          "v",
          9
        ]
      }
    ]
  },
  "expected": {
    "shown": [
      "s",
      "r",
      "x",
      "y"
    ],
    "stale": [
      true
    ],
    "changes": []
  }
}
