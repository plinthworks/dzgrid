{
  "id": "empty-past-end-kept-on-screen",
  "suite": "source-model",
  "description": "Next from a full page with no total finds an empty page: back to the page shown, kept as it is, with no next.",
  "input": {
    "columns": [
      {
        "id": "name"
      }
    ],
    "operations": "server",
    "pagination": {
      "pageSize": 2
    },
    "steps": [
      {
        "op": "answer",
        "call": "c1",
        "rows": [
          "a",
          "b"
        ],
        "hasNext": true
      },
      {
        "op": "go",
        "index": 1
      },
      {
        "op": "answer",
        "call": "c2",
        "rows": []
      }
    ]
  },
  "expected": {
    "calls": [
      {
        "name": "c1",
        "page": {
          "index": 0,
          "size": 2,
          "offset": 0,
          "cursor": null
        }
      },
      {
        "name": "c2",
        "page": {
          "index": 1,
          "size": 2,
          "offset": 2,
          "cursor": null
        }
      }
    ],
    "aborted": [],
    "changes": [
      "query",
      "page",
      "page"
    ],
    "final": {
      "status": "idle",
      "displayed": [
        "a",
        "b"
      ],
      "page": {
        "index": 0,
        "size": 2,
        "total": null,
        "pageCount": null,
        "hasNext": false,
        "canJump": true
      },
      "counts": {
        "total": null,
        "filtered": null,
        "displayed": 2
      }
    },
    "problems": [
      {
        "code": "invalid-page-response",
        "severity": "warning",
        "path": "response.hasNext"
      }
    ],
    "failures": []
  }
}
