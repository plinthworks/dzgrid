{
  "id": "wire-inactive-no-request",
  "suite": "source-model",
  "description": "Half-typed filters (an empty box, a range with one end) leave what is sent unchanged: no request, no new epoch, the page kept, the total still known.",
  "input": {
    "columns": [
      {
        "id": "name"
      },
      {
        "id": "t",
        "type": "instant"
      }
    ],
    "operations": "server",
    "pagination": {
      "pageSize": 2
    },
    "steps": [
      {
        "op": "answer",
        "call": "c1",
        "rows": [
          "a",
          "b"
        ],
        "total": 3
      },
      {
        "op": "go",
        "index": 1
      },
      {
        "op": "answer",
        "call": "c2",
        "rows": [
          "c"
        ],
        "total": 3
      },
      {
        "op": "query",
        "filter": {
          "name": {
            "type": "text",
            "op": "contains",
            "value": ""
          }
        }
      },
      {
        "op": "query",
        "filter": {
          "name": {
            "type": "text",
            "op": "startsWith"
          },
          "t": {
            "type": "instant",
            "op": "betweenDays",
            "day": "2026-03-05"
          }
        }
      }
    ]
  },
  "expected": {
    "calls": [
      {
        "name": "c1",
        "page": {
          "index": 0,
          "size": 2,
          "offset": 0,
          "cursor": null
        }
      },
      {
        "name": "c2",
        "page": {
          "index": 1,
          "size": 2,
          "offset": 2,
          "cursor": null
        }
      }
    ],
    "aborted": [],
    "changes": [
      "query",
      "page",
      "page"
    ],
    "final": {
      "status": "idle",
      "displayed": [
        "c"
      ],
      "page": {
        "index": 1,
        "size": 2,
        "total": 3,
        "pageCount": 2,
        "hasNext": false,
        "canJump": true
      },
      "counts": {
        "total": 3,
        "filtered": 3,
        "displayed": 1
      }
    },
    "problems": [],
    "failures": []
  }
}
