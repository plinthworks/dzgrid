{
  "id": "invalid-setting",
  "suite": "problems",
  "description": "`rowHeight` (owner D1, docs/behaviors/virtual-scroll.md « Row height »): a number from 24 (WCAG 2.5.8's target size) to 1 000 is taken; anything else is a warning at `settings.rowHeight`, the raw value in `detail`, and the density's height is used. Null and no value say nothing.",
  "input": {
    "op": "invalid-setting",
    "rowHeights": [52, 24, 1000, 23.5, 1001, 0, -40, "52", null, true]
  },
  "expected": {
    "problems": [
      { "code": "invalid-setting", "severity": "warning", "path": "settings.rowHeight", "detail": "23.5" },
      { "code": "invalid-setting", "severity": "warning", "path": "settings.rowHeight", "detail": "1001" },
      { "code": "invalid-setting", "severity": "warning", "path": "settings.rowHeight", "detail": "0" },
      { "code": "invalid-setting", "severity": "warning", "path": "settings.rowHeight", "detail": "-40" },
      { "code": "invalid-setting", "severity": "warning", "path": "settings.rowHeight", "detail": "52" },
      { "code": "invalid-setting", "severity": "warning", "path": "settings.rowHeight", "detail": "true" }
    ]
  }
}
