  "input": {
    "locale": "en-US",
    "kinds": [
      "between"
    ],
    "columns": [
      {
        "id": "n",
        "type": "number"
      }
    ],
    "rows": [
      {
        "id": "a",
        "n": 1
      },
      {
        "id": "b",
        "n": 3
      },
      {
        "id": "c",
        "n": 5
      },
      {
        "id": "d",
        "n": null
      },
      {
        "id": "e",
        "n": 7
      },
      {
        "id": "f",
        "n": "x"
      }
    ],
    "filter": {
      "n": {
        "type": "custom",
        "kind": "between",
        "state": {
          "lo": 5,
          "hi": 2
        }
      }
    }
  },
  "expected": {
    "ids": [
      "b",
      "c"
    ]
  }
