        "id": "a",
        "n": 1
      },
      {
        "id": "b",
        "n": 3
      },
      {
        "id": "c",
        "n": 5
      },
      {
        "id": "d",
        "n": null
      },
      {
        "id": "e",
        "n": 7
      },
      {
        "id": "f",
        "n": "x"
      }
    ],
    "filter": {
