{
  "id": "host-update-saved",
  "suite": "edit-saves",
  "description": "The host replacing a saved row shows its own value: the saved mark goes.",
  "input": {
    "columns": [
      {
        "id": "v",
        "type": "number",
        "editable": true
      },
      {
        "id": "w",
        "type": "number",
        "editable": true
      },
      {
        "id": "n",
        "editable": true
      }
    ],
    "rows": [
      {
        "id": "a",
        "v": 1,
        "w": 10,
        "n": "x"
      },
      {
        "id": "b",
        "v": 2,
        "w": 20,
        "n": "y"
      },
      {
        "id": "c",
        "v": 3,
        "w": 30,
        "n": "z"
      }
    ],
    "steps": [
      {
        "commit": [
          [
            "a",
            "v",
            5
          ]
        ]
      },
      {
        "ok": 1
      },
      {
        "tx": {
          "update": [
            {
              "id": "a",
              "v": 1,
              "w": 10,
              "n": "x"
            }
          ]
        }
      }
    ],
    "watch": [
      "a.v"
    ],
    "events": [
      "states"
    ]
  },
  "expected": {
    "after": [
      [
        "a.v=5 saving"
      ],
      [
        "a.v=5 saved"
      ],
      [
        "a.v=1 -"
      ]
    ],
    "events": [
      "states a.v user",
      "states a.v data",
      "states a.v data"
    ],
    "intact": true
  }
}
