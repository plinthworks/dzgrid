{
  "id": "one-gesture-one-request",
  "suite": "edit-saves",
  "description": "One gesture is one request: its changes with the value shown before and the row held; states, then saved.",
  "input": {
    "columns": [
      {
        "id": "v",
        "type": "number",
        "editable": true
      },
      {
        "id": "w",
        "type": "number",
        "editable": true
      },
      {
        "id": "n",
        "editable": true
      }
    ],
    "rows": [
      {
        "id": "a",
        "v": 1,
        "w": 10,
        "n": "x"
      },
      {
        "id": "b",
        "v": 2,
        "w": 20,
        "n": "y"
      },
      {
        "id": "c",
        "v": 3,
        "w": 30,
        "n": "z"
      }
    ],
    "steps": [
      {
        "commit": [
          [
            "a",
            "v",
            5
          ],
          [
            "b",
            "w",
            {
              "text": "25"
            }
          ]
        ]
      },
      {
        "ok": 1
      }
    ],
    "watch": [
      "a.v",
      "b.w"
    ]
  },
  "expected": {
    "results": [
      {
        "generation": 1,
        "staged": 2,
        "refused": []
      }
    ],
    "requests": [
      {
        "generation": 1,
        "origin": "edit",
        "changes": [
          [
            "a",
            "v",
            5,
            1
          ],
          [
            "b",
            "w",
            25,
            20
          ]
        ],
        "rows": [
          [
            "a",
            true
          ],
          [
            "b",
            true
          ]
        ]
      }
    ],
    "after": [
      [
        "a.v=5 saving",
        "b.w=25 saving"
      ],
      [
        "a.v=5 saved",
        "b.w=25 saved"
      ]
    ],
    "events": [
      "reader v,w user",
      "edited a.v 5<-1 edit user",
      "edited b.w 25<-20 edit user",
      "states a.v,b.w user",
      "undo true false user",
      "states a.v,b.w data"
    ],
    "intact": true,
    "dirty": false
  }
}
