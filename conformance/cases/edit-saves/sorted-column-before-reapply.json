{
  "id": "sorted-column-before-reapply",
  "suite": "edit-saves",
  "description": "Before a reapply the rows stay in place.",
  "input": {
    "columns": [
      {
        "id": "v",
        "type": "number",
        "editable": true
      },
      {
        "id": "w",
        "type": "number",
        "editable": true
      },
      {
        "id": "n",
        "editable": true
      }
    ],
    "rows": [
      {
        "id": "a",
        "v": 1,
        "w": 10,
        "n": "x"
      },
      {
        "id": "b",
        "v": 2,
        "w": 20,
        "n": "y"
      },
      {
        "id": "c",
        "v": 3,
        "w": 30,
        "n": "z"
      }
    ],
    "steps": [
      {
        "commit": [
          [
            "c",
            "v",
            0
          ]
        ]
      },
      {
        "ok": 1
      }
    ],
    "query": {
      "sort": [
        {
          "column": "v",
          "dir": "asc"
        }
      ]
    }
  },
  "expected": {
    "shown": [
      "a",
      "b",
      "c"
    ]
  }
}
