{
  "id": "generations-never-reused",
  "suite": "edit-saves",
  "description": "A refusal does not reset the generations.",
  "input": {
    "columns": [
      {
        "id": "v",
        "type": "number",
        "editable": true
      },
      {
        "id": "w",
        "type": "number",
        "editable": true
      },
      {
        "id": "n",
        "editable": true
      }
    ],
    "rows": [
      {
        "id": "a",
        "v": 1,
        "w": 10,
        "n": "x"
      },
      {
        "id": "b",
        "v": 2,
        "w": 20,
        "n": "y"
      },
      {
        "id": "c",
        "v": 3,
        "w": 30,
        "n": "z"
      }
    ],
    "steps": [
      {
        "commit": [
          [
            "a",
            "v",
            5
          ]
        ]
      },
      {
        "fail": 1,
        "error": {
          "reason": "no"
        }
      },
      {
        "commit": [
          [
            "a",
            "v",
            6
          ]
        ]
      }
    ],
    "watch": [
      "a.v"
    ]
  },
  "expected": {
    "results": [
      {
        "generation": 1,
        "staged": 1,
        "refused": []
      },
      {
        "generation": 2,
        "staged": 1,
        "refused": []
      }
    ],
    "after": [
      [
        "a.v=5 saving"
      ],
      [
        "a.v=1 failed"
      ],
      [
        "a.v=6 saving"
      ]
    ]
  }
}
