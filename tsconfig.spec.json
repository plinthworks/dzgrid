{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["vitest/globals", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@dzgrid/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "conformance/**/*.ts", "spikes/**/*.ts", "playground/**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
