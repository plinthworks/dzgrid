  },
  "include": [
    "packages/**/*.ts",
    "conformance/**/*.ts",
    "playground/**/*.ts",
    "perf/**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "packages/dom/test/browser/**"
  ]
}
