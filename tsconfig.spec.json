{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@dzgrid/core": [
        "./packages/core/src/index.ts"
      ],
      "@dzgrid/core/server": [
        "./packages/core/src/server.ts"
      ],
      "@dzgrid/core/spans": [
        "./packages/core/src/spans.ts"
      ],
      "@dzgrid/core/csv": [
        "./packages/core/src/csv.ts"
      ],
      "@dzgrid/core/rules": [
        "./packages/core/src/rules.ts"
      ],
      "@dzgrid/core/tree": [
        "./packages/core/src/tree.ts"
      ],
      "@dzgrid/core/tree-lazy": [
        "./packages/core/src/tree-lazy.ts"
      ],
      "@dzgrid/core/detail": [
        "./packages/core/src/detail.ts"
      ],
      "@dzgrid/core/edit": [
        "./packages/core/src/edit.ts"
      ],
      "@dzgrid/core/range": [
        "./packages/core/src/range.ts"
      ],
      "@dzgrid/core/state": [
        "./packages/core/src/state.ts"
      ],
      "@dzgrid/core/row-gaps": [
        "./packages/core/src/row-gaps.ts"
      ],
      "@dzgrid/core/compare": [
        "./packages/core/src/compare.ts"
      ],
      "@dzgrid/core/internal": [
        "./packages/core/src/internal.ts"
      ],
      "@dzgrid/dom": [
        "./packages/dom/src/index.ts"
      ],
      "@dzgrid/dom/spans": [
        "./packages/dom/src/spans.ts"
      ],
      "@dzgrid/dom/groups": [
        "./packages/dom/src/groups.ts"
      ],
      "@dzgrid/dom/slots": [
        "./packages/dom/src/slots.ts"
      ],
      "@dzgrid/dom/search": [
        "./packages/dom/src/search.ts"
      ],
      "@dzgrid/dom/filters": [
        "./packages/dom/src/filters.ts"
      ],
      "@dzgrid/dom/export": [
        "./packages/dom/src/export.ts"
      ],
      "@dzgrid/dom/parts": [
        "./packages/dom/src/parts.ts"
      ],
      "@dzgrid/dom/rules": [
        "./packages/dom/src/rules.ts"
      ],
      "@dzgrid/dom/tree": [
        "./packages/dom/src/tree.ts"
      ],
      "@dzgrid/dom/detail": [
        "./packages/dom/src/detail.ts"
      ],
      "@dzgrid/dom/edit": [
        "./packages/dom/src/edit.ts"
      ],
      "@dzgrid/dom/editors-list": [
        "./packages/dom/src/editors-list.ts"
      ],
      "@dzgrid/dom/editors": [
        "./packages/dom/src/editors.ts"
      ],
      "@dzgrid/dom/range": [
        "./packages/dom/src/range.ts"
      ],
      "@dzgrid/dom/fill": [
        "./packages/dom/src/fill.ts"
      ],
      "@dzgrid/dom/columns": [
        "./packages/dom/src/columns.ts"
      ],
      "@dzgrid/dom/column-menu": [
        "./packages/dom/src/column-menu.ts"
      ],
      "@dzgrid/dom/columns-panel": [
        "./packages/dom/src/columns-panel.ts"
      ],
      "@dzgrid/dom/state": [
        "./packages/dom/src/state.ts"
      ],
      "@dzgrid/dom/pinned-rows": [
        "./packages/dom/src/pinned-rows.ts"
      ],
      "@dzgrid/dom/row-gaps": [
        "./packages/dom/src/row-gaps.ts"
      ],
      "@dzgrid/dom/fresh-rows": [
        "./packages/dom/src/fresh-rows.ts"
      ],
      "@dzgrid/dom/auto-height": [
        "./packages/dom/src/auto-height.ts"
      ],
      "@dzgrid/dom/print": [
        "./packages/dom/src/print.ts"
      ],
      "@dzgrid/dom/tree-lazy": [
        "./packages/dom/src/tree-lazy.ts"
      ],
      "@dzgrid/dom/motion-gsap": [
        "./packages/dom/src/motion-gsap.ts"
      ],
      "@dzgrid/dom/pagination": [
        "./packages/dom/src/pagination.ts"
      ],
      "@dzgrid/dom/internal": [
        "./packages/dom/src/internal.ts"
      ],
      "@dzgrid/dom/locales/*": [
        "./packages/dom/src/locales/*.ts"
      ],
      "@dzgrid/angular": [
        "./packages/angular/src/index.ts"
      ]
