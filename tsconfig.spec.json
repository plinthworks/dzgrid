{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@dzgrid/core": [
        "./packages/core/src/index.ts"
      ],
      "@dzgrid/core/internal": [
        "./packages/core/src/internal.ts"
      ],
      "@dzgrid/dom": [
        "./packages/dom/src/index.ts"
      ],
      "@dzgrid/dom/locales/*": [
        "./packages/dom/src/locales/*.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "conformance/**/*.ts",
    "playground/**/*.ts",
    "perf/**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
